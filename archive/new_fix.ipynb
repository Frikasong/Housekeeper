    "# Install LibreOffice for DOCX/XLSX/PPTX → PDF conversion\n",
    "import subprocess, shutil\n",
    "if not shutil.which('soffice') and not shutil.which('libreoffice'):\n",
    "    print('Installing LibreOffice (required for office document layout preservation)...')\n",
    "    r = subprocess.run(\n",
    "        ['apt-get', 'update', '-qq'],\n",
    "        capture_output=True, timeout=120\n",
    "    )\n",
    "    r = subprocess.run(\n",
    "        ['apt-get', 'install', '-y', '-qq',\n",
    "         'libreoffice-core', 'libreoffice-common',\n",
    "         'libreoffice-writer', 'libreoffice-calc', 'libreoffice-impress',\n",
    "         'fonts-liberation', 'fonts-dejavu'],\n",
    "        capture_output=True, timeout=600\n",
    "    )\n",
    "    if r.returncode == 0:\n",
    "        print('LibreOffice installed successfully.')\n",
    "    else:\n",
    "        print('LibreOffice installation failed. Office documents may not preserve layout.')\n",
    "        print(r.stderr.decode()[-500:])\n",
    "else:\n",
    "    print('LibreOffice already available.')\n",
    "\n",
    "print('\\nAll dependencies installed.')\n"
