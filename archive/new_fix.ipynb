   "source": [
    "# Cell 4 — Flask app with ALL layout-preservation fixes\n",
    "# -*- coding: utf-8 -*-\n",
    "import os, json, uuid, io, subprocess, csv, shutil, tempfile, traceback\n",
    "from xml.sax.saxutils import escape as xml_escape\n",
    "from flask import Flask, request, jsonify, send_file, render_template\n",
    "from werkzeug.utils import secure_filename\n",
    "from PIL import Image\n",
    "from reportlab.lib.pagesizes import letter\n",
    "from reportlab.lib import colors\n",
    "from reportlab.lib.units import inch\n",
    "from reportlab.platypus import (\n",
    "    SimpleDocTemplate, Paragraph, Spacer, PageBreak,\n",
    "    Image as RLImage, Table, TableStyle, HRFlowable,\n",
    "    XPreformatted, KeepTogether,\n",
    ")\n",
    "from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle\n",
    "from reportlab.lib.enums import TA_CENTER, TA_LEFT, TA_RIGHT\n",
    "from reportlab.pdfgen import canvas\n",
    "from reportlab.platypus.flowables import Flowable\n",
    "\n",
    "try:\n",
    "    import fitz as pymupdf\n",
    "    HAS_PYMUPDF = True\n",
    "    print(f'PyMuPDF {pymupdf.version[0]} loaded.')\n",
    "except ImportError:\n",
    "    HAS_PYMUPDF = False\n",
    "    print('WARNING: PyMuPDF not available. PDF merging and office doc rendering will be limited.')\n",
    "\n",
    "try:\n",
    "    import pdfplumber\n",
    "    HAS_PDFPLUMBER = True\n",
    "except ImportError:\n",
    "    HAS_PDFPLUMBER = False\n",
    "\n",
    "try:\n",
    "    from docx import Document as DocxDocument\n",
    "    HAS_DOCX = True\n",
    "except ImportError:\n",
    "    HAS_DOCX = False\n",
    "\n",
    "try:\n",
    "    import openpyxl\n",
    "    HAS_OPENPYXL = True\n",
    "except ImportError:\n",
    "    HAS_OPENPYXL = False\n",
    "\n",
    "# ─── Flask app ────────────────────────────────────────────────────────────────\n",
    "app = Flask(__name__, template_folder='/content/templates')\n",
    "app.config['UPLOAD_FOLDER'] = '/content/uploads'\n",
    "app.config['TEMP_FOLDER'] = '/content/uploads/temp'\n",
    "app.config['MAX_CONTENT_LENGTH'] = 50 * 1024 * 1024  # 50 MB per request\n",
    "MAX_SINGLE_FILE_SIZE = 40 * 1024 * 1024  # 40 MB per individual file for LO conversion\n",
    "\n",
    "IMAGE_EXTS = {'png', 'jpg', 'jpeg', 'gif', 'bmp', 'tiff', 'tif', 'webp'}\n",
    "PLAIN_TEXT_EXTS = {\n",
    "    'txt', 'md', 'log', 'py', 'js', 'ts', 'html', 'htm',\n",
    "    'css', 'json', 'xml', 'yaml', 'yml', 'ini', 'cfg', 'conf',\n",
    "    'sql', 'sh', 'bat', 'tex', 'rst',\n",
    "}\n",
    "CSV_EXTS = {'csv', 'tsv'}\n",
    "OFFICE_EXTS = {'docx', 'doc', 'xlsx', 'xls', 'pptx', 'ppt',\n",
    "               'odt', 'ods', 'odp', 'rtf'}\n",
    "\n",
    "\n",
    "def _get_ext(path):\n",
    "    return path.rsplit('.', 1)[-1].lower() if '.' in path else ''\n",
    "\n",
    "\n",
    "def is_image_file(path):\n",
    "    return _get_ext(path) in IMAGE_EXTS\n",
    "\n",
    "\n",
    "def is_pdf_file(path):\n",
    "    return _get_ext(path) == 'pdf'\n",
    "\n",
    "\n",
    "# ─── LIBREOFFICE DETECTION ────────────────────────────────────────────────────\n",
    "\n",
    "_LO_CMD_CACHE = [None, False]\n",
    "\n",
    "def _find_libreoffice():\n",
    "    for cmd in ['soffice', 'libreoffice',\n",
    "                '/usr/bin/soffice', '/usr/bin/libreoffice',\n",
    "                '/Applications/LibreOffice.app/Contents/MacOS/soffice']:\n",
    "        if shutil.which(cmd):\n",
    "            return cmd\n",
    "    return None\n",
    "\n",
    "def _get_lo_cmd():\n",
    "    if not _LO_CMD_CACHE[1]:\n",
    "        _LO_CMD_CACHE[0] = _find_libreoffice()\n",
    "        _LO_CMD_CACHE[1] = True\n",
    "        if _LO_CMD_CACHE[0]:\n",
    "            print(f'LibreOffice found: {_LO_CMD_CACHE[0]}')\n",
    "        else:\n",
    "            print('WARNING: LibreOffice not found. Office document layout preservation unavailable.')\n",
    "    return _LO_CMD_CACHE[0]\n",
    "\n",
    "\n",
    "# ─── OFFICE → PDF (via LibreOffice) ──────────────────────────────────────────\n",
    "\n",
    "def _convert_office_to_pdf(file_path):\n",
    "    \"\"\"Convert an office document to PDF using LibreOffice.\n",
    "    Returns path to the converted PDF, or None on failure.\n",
    "    Uses a unique temp directory to avoid naming collisions.\n",
    "    \"\"\"\n",
    "    lo_cmd = _get_lo_cmd()\n",
    "    if not lo_cmd:\n",
    "        return None\n",
    "\n",
    "    # Guard: skip very large files\n",
    "    try:\n",
    "        if os.path.getsize(file_path) > MAX_SINGLE_FILE_SIZE:\n",
    "            print(f'Skipping LO conversion: file too large ({os.path.getsize(file_path)} bytes)')\n",
    "            return None\n",
    "    except OSError:\n",
    "        return None\n",
    "\n",
    "    # Use unique temp dir to avoid naming collisions\n",
    "    tmp_dir = tempfile.mkdtemp(dir=app.config['TEMP_FOLDER'])\n",
    "    try:\n",
    "        result = subprocess.run(\n",
    "            [lo_cmd, '--headless', '--norestore', '--convert-to', 'pdf',\n",
    "             '--outdir', tmp_dir, file_path],\n",
    "            capture_output=True, timeout=180,\n",
    "        )\n",
    "        if result.returncode != 0:\n",
    "            print(f'LibreOffice conversion failed: {result.stderr.decode()[-300:]}')\n",
    "            return None\n",
    "\n",
    "        # Find the output PDF\n",
    "        base = os.path.splitext(os.path.basename(file_path))[0]\n",
    "        out_path = os.path.join(tmp_dir, base + '.pdf')\n",
    "        if not os.path.exists(out_path):\n",
    "            # Sometimes LO changes the name; find any PDF in tmp_dir\n",
    "            pdfs = [f for f in os.listdir(tmp_dir) if f.lower().endswith('.pdf')]\n",
    "            if pdfs:\n",
    "                out_path = os.path.join(tmp_dir, pdfs[0])\n",
    "            else:\n",
    "                return None\n",
    "\n",
    "        # Move to uploads with unique name\n",
    "        final_path = os.path.join(\n",
    "            app.config['UPLOAD_FOLDER'],\n",
    "            'loconv_%s.pdf' % uuid.uuid4().hex\n",
    "        )\n",
    "        shutil.move(out_path, final_path)\n",
    "        return final_path\n",
    "    except subprocess.TimeoutExpired:\n",
    "        print('LibreOffice conversion timed out')\n",
    "        return None\n",
    "    except Exception as e:\n",
    "        print(f'LibreOffice conversion error: {e}')\n",
    "        return None\n",
    "    finally:\n",
    "        # Clean up temp dir\n",
    "        try:\n",
    "            shutil.rmtree(tmp_dir, ignore_errors=True)\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "\n",
    "# ─── TEXT → PDF (preserving whitespace) ───────────────────────────────────────\n",
    "\n",
    "def _convert_text_to_pdf(file_path):\n",
    "    \"\"\"Render plain text with preserved whitespace using XPreformatted.\"\"\"\n",
    "    try:\n",
    "        with open(file_path, 'r', encoding='utf-8', errors='replace') as f:\n",
    "            text = f.read()\n",
    "    except Exception:\n",
    "        return None\n",
    "    if not text.strip():\n",
    "        return None\n",
    "\n",
    "    out_path = os.path.join(\n",
    "        app.config['UPLOAD_FOLDER'],\n",
    "        'textconv_%s.pdf' % uuid.uuid4().hex,\n",
    "    )\n",
    "    try:\n",
    "        doc = SimpleDocTemplate(\n",
    "            out_path, pagesize=letter,\n",
    "            leftMargin=0.5*inch, rightMargin=0.5*inch,\n",
    "            topMargin=0.5*inch, bottomMargin=0.5*inch,\n",
    "        )\n",
    "        styles = getSampleStyleSheet()\n",
    "        # XPreformatted preserves whitespace and tabs\n",
    "        code_style = ParagraphStyle(\n",
    "            'TextConvFixed', parent=styles['Code'],\n",
    "            fontName='Courier', fontSize=7.5, leading=9.5,\n",
    "            spaceBefore=0, spaceAfter=0,\n",
    "            wordWrap='CJK',  # allows breaking long lines\n",
    "        )\n",
    "        story = []\n",
    "        # Replace tabs with spaces for consistent rendering\n",
    "        text = text.replace('\\t', '    ')\n",
    "        safe = xml_escape(text)\n",
    "        story.append(XPreformatted(safe, code_style))\n",
    "        doc.build(story)\n",
    "        return out_path\n",
    "    except Exception as e:\n",
    "        print(f'Text→PDF conversion error: {e}')\n",
    "        try:\n",
    "            os.unlink(out_path)\n",
    "        except OSError:\n",
    "            pass\n",
    "        return None\n",
    "\n",
    "\n",
    "# ─── CSV → PDF (proper table with grid) ───────────────────────────────────────\n",
    "\n",
    "def _convert_csv_to_pdf(file_path):\n",
    "    \"\"\"Render CSV/TSV as a proper table with grid lines.\"\"\"\n",
    "    ext = _get_ext(file_path)\n",
    "    try:\n",
    "        with open(file_path, 'r', encoding='utf-8', errors='replace') as f:\n",
    "            if ext == 'tsv':\n",
    "                reader = csv.reader(f, delimiter='\\t')\n",
    "            else:\n",
    "                # Sniff delimiter\n",
    "                sample = f.read(4096)\n",
    "                f.seek(0)\n",
    "                try:\n",
    "                    dialect = csv.Sniffer().sniff(sample)\n",
    "                    reader = csv.reader(f, dialect)\n",
    "                except csv.Error:\n",
    "                    reader = csv.reader(f)\n",
    "            rows = list(reader)\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "    if not rows:\n",
    "        return None\n",
    "\n",
    "    out_path = os.path.join(\n",
    "        app.config['UPLOAD_FOLDER'],\n",
    "        'csvconv_%s.pdf' % uuid.uuid4().hex,\n",
    "    )\n",
    "    try:\n",
    "        page_w, page_h = letter\n",
    "        doc = SimpleDocTemplate(\n",
    "            out_path, pagesize=letter,\n",
    "            leftMargin=0.4*inch, rightMargin=0.4*inch,\n",
    "            topMargin=0.5*inch, bottomMargin=0.5*inch,\n",
    "        )\n",
    "        usable_w = page_w - 0.8*inch\n",
    "\n",
    "        # Determine max columns\n",
    "        max_cols = max(len(r) for r in rows) if rows else 1\n",
    "        col_w = usable_w / max_cols\n",
    "\n",
    "        styles = getSampleStyleSheet()\n",
    "        cell_style = ParagraphStyle(\n",
    "            'CSVCell', parent=styles['Normal'],\n",
    "            fontName='Helvetica', fontSize=6.5, leading=8,\n",
    "            wordWrap='CJK',\n",
    "        )\n",
    "        header_style = ParagraphStyle(\n",
    "            'CSVHeader', parent=cell_style,\n",
    "            fontName='Helvetica-Bold', fontSize=7,\n",
    "        )\n",
    "\n",
    "        # Normalize rows to same column count\n",
    "        table_data = []\n",
    "        for row_idx, row in enumerate(rows):\n",
    "            # Pad short rows\n",
    "            padded = list(row) + [''] * (max_cols - len(row))\n",
    "            style = header_style if row_idx == 0 else cell_style\n",
    "            table_data.append(\n",
    "                [Paragraph(xml_escape(str(c)[:200]), style) for c in padded[:max_cols]]\n",
    "            )\n",
    "\n",
    "        table = Table(table_data, colWidths=[col_w]*max_cols, repeatRows=1)\n",
    "        table.setStyle(TableStyle([\n",
    "            ('FONTNAME',       (0, 0), (-1, 0), 'Helvetica-Bold'),\n",
    "            ('BACKGROUND',     (0, 0), (-1, 0), colors.HexColor('#e8edf5')),\n",
    "            ('ROWBACKGROUNDS', (0, 1), (-1, -1),\n",
    "             [colors.white, colors.HexColor('#f8f9fb')]),\n",
    "            ('GRID',           (0, 0), (-1, -1), 0.4, colors.HexColor('#cccccc')),\n",
    "            ('VALIGN',         (0, 0), (-1, -1), 'TOP'),\n",
    "            ('TOPPADDING',     (0, 0), (-1, -1), 3),\n",
    "            ('BOTTOMPADDING',  (0, 0), (-1, -1), 3),\n",
    "            ('LEFTPADDING',    (0, 0), (-1, -1), 4),\n",
    "            ('RIGHTPADDING',   (0, 0), (-1, -1), 4),\n",
    "        ]))\n",
    "\n",
    "        doc.build([table])\n",
    "        return out_path\n",
    "    except Exception as e:\n",
    "        print(f'CSV→PDF conversion error: {e}')\n",
    "        try:\n",
    "            os.unlink(out_path)\n",
    "        except OSError:\n",
    "            pass\n",
    "        return None\n",
    "\n",
    "\n",
    "# ─── XLSX → PDF (proper table fallback when LO unavailable) ───────────────────\n",
    "\n",
    "def _convert_xlsx_to_pdf_table(file_path):\n",
    "    \"\"\"Render XLSX as proper table(s) with grid — fallback when LO not available.\"\"\"\n",
    "    if not HAS_OPENPYXL:\n",
    "        return None\n",
    "    try:\n",
    "        wb = openpyxl.load_workbook(file_path, read_only=True, data_only=True)\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "    out_path = os.path.join(\n",
    "        app.config['UPLOAD_FOLDER'],\n",
    "        'xlsxconv_%s.pdf' % uuid.uuid4().hex,\n",
    "    )\n",
    "    try:\n",
    "        page_w, page_h = letter\n",
    "        doc = SimpleDocTemplate(\n",
    "            out_path, pagesize=letter,\n",
    "            leftMargin=0.4*inch, rightMargin=0.4*inch,\n",
    "            topMargin=0.5*inch, bottomMargin=0.5*inch,\n",
    "        )\n",
    "        usable_w = page_w - 0.8*inch\n",
    "        styles = getSampleStyleSheet()\n",
    "        story = []\n",
    "\n",
    "        sheet_title_style = ParagraphStyle(\n",
    "            'SheetTitle', parent=styles['Heading2'],\n",
    "            fontName='Helvetica-Bold', fontSize=11,\n",
    "            textColor=colors.HexColor('#1a3a5c'),\n",
    "            spaceBefore=12, spaceAfter=8,\n",
    "        )\n",
    "        cell_style = ParagraphStyle(\n",
    "            'XLSXCell', parent=styles['Normal'],\n",
    "            fontName='Helvetica', fontSize=6.5, leading=8,\n",
    "            wordWrap='CJK',\n",
    "        )\n",
    "        header_style = ParagraphStyle(\n",
    "            'XLSXHeader', parent=cell_style,\n",
    "            fontName='Helvetica-Bold', fontSize=7,\n",
    "        )\n",
    "\n",
    "        for sheet_idx, sn in enumerate(wb.sheetnames):\n",
    "            ws = wb[sn]\n",
    "            rows = []\n",
    "            for row in ws.iter_rows(values_only=True):\n",
    "                rows.append([str(c) if c is not None else '' for c in row])\n",
    "            if not rows:\n",
    "                continue\n",
    "\n",
    "            if sheet_idx > 0:\n",
    "                story.append(PageBreak())\n",
    "\n",
    "            story.append(Paragraph('Sheet: %s' % xml_escape(sn), sheet_title_style))\n",
    "\n",
    "            max_cols = max(len(r) for r in rows)\n",
    "            if max_cols == 0:\n",
    "                continue\n",
    "            col_w = min(usable_w / max_cols, 2.5*inch)\n",
    "\n",
    "            table_data = []\n",
    "            for row_idx, row in enumerate(rows):\n",
    "                padded = list(row) + [''] * (max_cols - len(row))\n",
    "                style = header_style if row_idx == 0 else cell_style\n",
    "                table_data.append(\n",
    "                    [Paragraph(xml_escape(str(c)[:200]), style)\n",
    "                     for c in padded[:max_cols]]\n",
    "                )\n",
    "\n",
    "            table = Table(table_data,\n",
    "                          colWidths=[col_w]*max_cols,\n",
    "                          repeatRows=1)\n",
    "            table.setStyle(TableStyle([\n",
    "                ('FONTNAME',       (0, 0), (-1, 0), 'Helvetica-Bold'),\n",
    "                ('BACKGROUND',     (0, 0), (-1, 0), colors.HexColor('#e8edf5')),\n",
    "                ('ROWBACKGROUNDS', (0, 1), (-1, -1),\n",
    "                 [colors.white, colors.HexColor('#f8f9fb')]),\n",
    "                ('GRID',           (0, 0), (-1, -1), 0.4, colors.HexColor('#cccccc')),\n",
    "                ('VALIGN',         (0, 0), (-1, -1), 'TOP'),\n",
    "                ('TOPPADDING',     (0, 0), (-1, -1), 3),\n",
    "                ('BOTTOMPADDING',  (0, 0), (-1, -1), 3),\n",
    "                ('LEFTPADDING',    (0, 0), (-1, -1), 4),\n",
    "                ('RIGHTPADDING',   (0, 0), (-1, -1), 4),\n",
    "            ]))\n",
    "            story.append(table)\n",
    "\n",
    "        wb.close()\n",
    "        if not story:\n",
    "            return None\n",
    "        doc.build(story)\n",
    "        return out_path\n",
    "    except Exception as e:\n",
    "        print(f'XLSX table→PDF error: {e}')\n",
    "        try:\n",
    "            os.unlink(out_path)\n",
    "        except OSError:\n",
    "            pass\n",
    "        return None\n",
    "\n",
    "\n",
    "# ─── UNIVERSAL DOCUMENT → PDF CONVERSION ──────────────────────────────────────\n",
    "\n",
    "def convert_document_to_pdf(file_path):\n",
    "    \"\"\"Convert any non-image file to a PDF, preserving layout as best as possible.\n",
    "    Returns path to PDF file, or None.\n",
    "    Priority:\n",
    "      1. Already a PDF → return as-is\n",
    "      2. Office docs → LibreOffice\n",
    "      3. CSV/TSV → proper table\n",
    "      4. XLSX without LO → table fallback\n",
    "      5. Plain text → XPreformatted\n",
    "    \"\"\"\n",
    "    ext = _get_ext(file_path)\n",
    "\n",
    "    if ext == 'pdf':\n",
    "        return file_path  # Already PDF\n",
    "\n",
    "    if ext in IMAGE_EXTS:\n",
    "        return None  # Images handled separately\n",
    "\n",
    "    # Try LibreOffice for office formats\n",
    "    if ext in OFFICE_EXTS:\n",
    "        pdf_path = _convert_office_to_pdf(file_path)\n",
    "        if pdf_path:\n",
    "            return pdf_path\n",
    "        # Fallback for xlsx without LO\n",
    "        if ext in ('xlsx', 'xls'):\n",
    "            return _convert_xlsx_to_pdf_table(file_path)\n",
    "        # No good fallback for docx/pptx without LO — try text extraction\n",
    "        if ext == 'docx' and HAS_DOCX:\n",
    "            return _convert_docx_text_fallback(file_path)\n",
    "        return None\n",
    "\n",
    "    # CSV/TSV → proper table\n",
    "    if ext in CSV_EXTS:\n",
    "        return _convert_csv_to_pdf(file_path)\n",
    "\n",
    "    # Plain text\n",
    "    if ext in PLAIN_TEXT_EXTS:\n",
    "        return _convert_text_to_pdf(file_path)\n",
    "\n",
    "    # Unknown extension — try as text\n",
    "    try:\n",
    "        with open(file_path, 'r', encoding='utf-8') as f:\n",
    "            f.read(512)  # test if readable as text\n",
    "        return _convert_text_to_pdf(file_path)\n",
    "    except (UnicodeDecodeError, Exception):\n",
    "        pass\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def _convert_docx_text_fallback(file_path):\n",
    "    \"\"\"Last-resort DOCX→PDF: extract paragraphs with basic formatting.\"\"\"\n",
    "    try:\n",
    "        doc = DocxDocument(file_path)\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "    out_path = os.path.join(\n",
    "        app.config['UPLOAD_FOLDER'],\n",
    "        'docxfb_%s.pdf' % uuid.uuid4().hex,\n",
    "    )\n",
    "    try:\n",
    "        pdf_doc = SimpleDocTemplate(\n",
    "            out_path, pagesize=letter,\n",
    "            leftMargin=0.75*inch, rightMargin=0.75*inch,\n",
    "            topMargin=0.75*inch, bottomMargin=0.75*inch,\n",
    "        )\n",
    "        styles = getSampleStyleSheet()\n",
    "        normal = ParagraphStyle(\n",
    "            'DocxNormal', parent=styles['Normal'],\n",
    "            fontSize=10, leading=14, spaceAfter=6,\n",
    "        )\n",
    "        heading = ParagraphStyle(\n",
    "            'DocxHeading', parent=styles['Heading2'],\n",
    "            fontSize=13, leading=16, spaceAfter=8, spaceBefore=12,\n",
    "            textColor=colors.HexColor('#1a3a5c'),\n",
    "        )\n",
    "\n",
    "        story = []\n",
    "        # Add a note that this is a text-only rendering\n",
    "        note_style = ParagraphStyle(\n",
    "            'DocxNote', parent=styles['Normal'],\n",
    "            fontName='Helvetica-Oblique', fontSize=8,\n",
    "            textColor=colors.HexColor('#999999'), spaceAfter=12,\n",
    "        )\n",
    "        story.append(Paragraph(\n",
    "            '[Note: This document was converted using text extraction. '\n",
    "            'Some formatting may differ from the original. '\n",
    "            'Install LibreOffice for exact layout preservation.]',\n",
    "            note_style))\n",
    "        story.append(HRFlowable(width='100%', thickness=0.5,\n",
    "                                color=colors.HexColor('#cccccc')))\n",
    "        story.append(Spacer(1, 0.15*inch))\n",
    "\n",
    "        for para in doc.paragraphs:\n",
    "            text = para.text.strip()\n",
    "            if not text:\n",
    "                story.append(Spacer(1, 6))\n",
    "                continue\n",
    "            safe = xml_escape(text)\n",
    "            # Check if heading\n",
    "            if para.style and para.style.name and 'Heading' in para.style.name:\n",
    "                story.append(Paragraph(safe, heading))\n",
    "            else:\n",
    "                # Try to preserve bold/italic from runs\n",
    "                parts = []\n",
    "                for run in para.runs:\n",
    "                    t = xml_escape(run.text)\n",
    "                    if run.bold and run.italic:\n",
    "                        parts.append('<b><i>%s</i></b>' % t)\n",
    "                    elif run.bold:\n",
    "                        parts.append('<b>%s</b>' % t)\n",
    "                    elif run.italic:\n",
    "                        parts.append('<i>%s</i>' % t)\n",
    "                    else:\n",
    "                        parts.append(t)\n",
    "                html = ''.join(parts) if parts else safe\n",
    "                story.append(Paragraph(html, normal))\n",
    "\n",
    "        # Also extract tables from docx\n",
    "        if doc.tables:\n",
    "            story.append(Spacer(1, 0.2*inch))\n",
    "            page_w, _ = letter\n",
    "            usable_w = page_w - 1.5*inch\n",
    "            cell_style = ParagraphStyle(\n",
    "                'DocxTableCell', parent=styles['Normal'],\n",
    "                fontSize=8, leading=10,\n",
    "            )\n",
    "            for tbl in doc.tables:\n",
    "                tbl_data = []\n",
    "                max_cols = 0\n",
    "                for row in tbl.rows:\n",
    "                    cells = [xml_escape(c.text[:200]) for c in row.cells]\n",
    "                    max_cols = max(max_cols, len(cells))\n",
    "                    tbl_data.append(cells)\n",
    "                if not tbl_data or max_cols == 0:\n",
    "                    continue\n",
    "                # Normalize\n",
    "                norm = []\n",
    "                for r in tbl_data:\n",
    "                    padded = r + [''] * (max_cols - len(r))\n",
    "                    norm.append([Paragraph(c, cell_style) for c in padded[:max_cols]])\n",
    "                col_w = usable_w / max_cols\n",
    "                table = Table(norm, colWidths=[col_w]*max_cols)\n",
    "                table.setStyle(TableStyle([\n",
    "                    ('GRID', (0,0), (-1,-1), 0.4, colors.HexColor('#cccccc')),\n",
    "                    ('VALIGN', (0,0), (-1,-1), 'TOP'),\n",
    "                    ('TOPPADDING', (0,0), (-1,-1), 3),\n",
    "                    ('BOTTOMPADDING', (0,0), (-1,-1), 3),\n",
    "                ]))\n",
    "                story.append(table)\n",
    "                story.append(Spacer(1, 0.15*inch))\n",
    "\n",
    "        if len(story) <= 3:  # only the note + hr + spacer\n",
    "            return None\n",
    "        pdf_doc.build(story)\n",
    "        return out_path\n",
    "    except Exception as e:\n",
    "        print(f'DOCX text fallback error: {e}')\n",
    "        try:\n",
    "            os.unlink(out_path)\n",
    "        except OSError:\n",
    "            pass\n",
    "        return None\n",
    "\n",
    "\n",
    "# ─── PDF MERGING (direct page insertion — preserves text/vectors) ─────────────\n",
    "\n",
    "def get_pdf_page_count(pdf_path):\n",
    "    \"\"\"Return number of pages in a PDF.\"\"\"\n",
    "    if not HAS_PYMUPDF:\n",
    "        return 0\n",
    "    try:\n",
    "        doc = pymupdf.open(pdf_path)\n",
    "        count = len(doc)\n",
    "        doc.close()\n",
    "        return count\n",
    "    except Exception:\n",
    "        return 0\n",
    "\n",
    "\n",
    "# ─── PAGE NUMBERING CANVAS ───────────────────────────────────────────────────\n",
    "\n",
    "class NumberedCanvas(canvas.Canvas):\n",
    "    def __init__(self, *args, **kwargs):\n",
    "        super().__init__(*args, **kwargs)\n",
    "        self._saved_page_states = []\n",
    "\n",
    "    def showPage(self):\n",
    "        self._saved_page_states.append(dict(self.__dict__))\n",
    "        self._startPage()\n",
    "\n",
    "    def save(self):\n",
    "        for state in self._saved_page_states:\n",
    "            self.__dict__.update(state)\n",
    "            self.draw_page_footer()\n",
    "            super().showPage()\n",
    "        super().save()\n",
    "\n",
    "    def draw_page_footer(self):\n",
    "        self.setFont('Helvetica', 8)\n",
    "        self.setFillColor(colors.HexColor('#666666'))\n",
    "        width, height = letter\n",
    "        self.drawRightString(width - 0.5*inch, 0.4*inch,\n",
    "                             'Page %d' % self._pageNumber)\n",
    "        self.drawString(0.5*inch, 0.4*inch, 'Evidence Brief')\n",
    "        self.setStrokeColor(colors.HexColor('#cccccc'))\n",
    "        self.setLineWidth(0.5)\n",
    "        self.line(0.5*inch, 0.55*inch, width - 0.5*inch, 0.55*inch)\n",
    "\n",
    "\n",
    "# ─── TAB DIVIDER FLOWABLE ────────────────────────────────────────────────────\n",
    "\n",
    "class TabDivider(Flowable):\n",
    "    def __init__(self, tab_number, tab_title, width, height,\n",
    "                 page_registry=None, registry_key=None):\n",
    "        super().__init__()\n",
    "        self.tab_number = tab_number\n",
    "        self.tab_title = tab_title\n",
    "        self.width = width\n",
    "        self.height = height\n",
    "        self.page_registry = page_registry\n",
    "        self.registry_key = registry_key if registry_key is not None else tab_number\n",
    "\n",
    "    def draw(self):\n",
    "        if self.page_registry is not None:\n",
    "            self.page_registry[self.registry_key] = self.canv._pageNumber\n",
    "        tab_color = colors.HexColor('#1a3a5c')\n",
    "        self.canv.setFillColor(tab_color)\n",
    "        self.canv.rect(self.width - 1.5*inch, -0.5*inch,\n",
    "                       1.5*inch, self.height + 1*inch, fill=1, stroke=0)\n",
    "        self.canv.setFillColor(colors.white)\n",
    "        self.canv.setFont('Helvetica-Bold', 14)\n",
    "        self.canv.saveState()\n",
    "        self.canv.translate(self.width - 0.75*inch, self.height/2)\n",
    "        self.canv.rotate(270)\n",
    "        label = 'TAB %d' % self.tab_number\n",
    "        if self.tab_title:\n",
    "            label += '  -  ' + self.tab_title\n",
    "        self.canv.drawCentredString(0, 0, label)\n",
    "        self.canv.restoreState()\n",
    "        self.canv.setFillColor(colors.HexColor('#1a3a5c'))\n",
    "        self.canv.setFont('Helvetica-Bold', 72)\n",
    "        self.canv.drawCentredString(\n",
    "            (self.width - 1.5*inch)/2, self.height/2 - 0.25*inch,\n",
    "            str(self.tab_number))\n",
    "        if self.tab_title:\n",
    "            self.canv.setFont('Helvetica', 18)\n",
    "            self.canv.drawCentredString(\n",
    "                (self.width - 1.5*inch)/2, self.height/2 - 0.9*inch,\n",
    "                self.tab_title)\n",
    "\n",
    "    def wrap(self, availWidth, availHeight):\n",
    "        return self.width, self.height\n",
    "\n",
    "\n",
    "# ─── PDF PAGE PLACEHOLDER ────────────────────────────────────────────────────\n",
    "# When we merge external PDF pages, we need a placeholder in the ReportLab\n",
    "# story so page numbering stays correct.\n",
    "\n",
    "class PDFPagePlaceholder(Flowable):\n",
    "    \"\"\"A full-page placeholder that records its page number.\n",
    "    The actual PDF content is merged in post-processing.\"\"\"\n",
    "    def __init__(self, width, height, label='',\n",
    "                 page_offset_registry=None, registry_key=None):\n",
    "        super().__init__()\n",
    "        self.width = width\n",
    "        self.height = height\n",
    "        self.label = label\n",
    "        self.page_offset_registry = page_offset_registry\n",
    "        self.registry_key = registry_key\n",
    "\n",
    "    def draw(self):\n",
    "        if self.page_offset_registry is not None and self.registry_key is not None:\n",
    "            self.page_offset_registry[self.registry_key] = self.canv._pageNumber\n",
    "        # Draw a light placeholder\n",
    "        self.canv.setFillColor(colors.HexColor('#f5f7fa'))\n",
    "        self.canv.rect(0, 0, self.width, self.height, fill=1, stroke=0)\n",
    "        self.canv.setFillColor(colors.HexColor('#aaaaaa'))\n",
    "        self.canv.setFont('Helvetica', 10)\n",
    "        self.canv.drawCentredString(\n",
    "            self.width/2, self.height/2,\n",
    "            self.label or '[Document page]')\n",
    "\n",
    "    def wrap(self, availWidth, availHeight):\n",
    "        return self.width, self.height\n",
    "\n",
    "\n",
    "# ─── STORY BUILDER ───────────────────────────────────────────────────────────\n",
    "\n",
    "def _build_story(case_info, tabs_data, usable_w, usable_h,\n",
    "                 page_registry=None, tab_pages=None,\n",
    "                 converted_pdfs=None,\n",
    "                 pdf_insert_plan=None):\n",
    "    \"\"\"Build the ReportLab story.\n",
    "\n",
    "    converted_pdfs: dict mapping original file path → converted PDF path\n",
    "    pdf_insert_plan: list to append (placeholder_page, pdf_path, pdf_page_idx) tuples\n",
    "    \"\"\"\n",
    "    if converted_pdfs is None:\n",
    "        converted_pdfs = {}\n",
    "    if pdf_insert_plan is None:\n",
    "        pdf_insert_plan = []\n",
    "\n",
    "    styles = getSampleStyleSheet()\n",
    "    story = []\n",
    "    navy = colors.HexColor('#1a3a5c')\n",
    "    gold = colors.HexColor('#c8a951')\n",
    "\n",
    "    # ── TITLE PAGE ───────────────────────────────────────────────────────\n",
    "    story.append(Spacer(1, 1.5*inch))\n",
    "    title_style = ParagraphStyle(\n",
    "        'BriefTitle', parent=styles['Normal'],\n",
    "        fontName='Helvetica-Bold', fontSize=36,\n",
    "        textColor=navy, alignment=TA_CENTER, spaceAfter=0)\n",
    "    story.append(Paragraph('Evidence Brief', title_style))\n",
    "    story.append(Spacer(1, 0.28*inch))\n",
    "    story.append(HRFlowable(width='100%', thickness=3, color=gold))\n",
    "    story.append(Spacer(1, 0.4*inch))\n",
    "\n",
    "    label_style = ParagraphStyle(\n",
    "        'Label', parent=styles['Normal'],\n",
    "        fontName='Helvetica-Bold', fontSize=10,\n",
    "        textColor=navy, spaceBefore=4)\n",
    "    value_style = ParagraphStyle(\n",
    "        'Value', parent=styles['Normal'],\n",
    "        fontName='Helvetica', fontSize=11, spaceBefore=2)\n",
    "\n",
    "    def row(label, value):\n",
    "        return [Paragraph(label, label_style),\n",
    "                Paragraph(value or '\\u2014', value_style)]\n",
    "\n",
    "    case_table_data = [\n",
    "        row('FILE NUMBER',       case_info.get('file_number', '')),\n",
    "        row('HEARING DATE',      case_info.get('hearing_date', '')),\n",
    "        row('APPLICANT',         case_info.get('applicant_name', '')),\n",
    "        row('APPLICANT ADDRESS', case_info.get('applicant_address', '')),\n",
    "        row('RESPONDENT',        case_info.get('respondent_name', '')),\n",
    "        row('RESPONDENT ADDRESS',case_info.get('respondent_address', '')),\n",
    "    ]\n",
    "    col_w = [1.8*inch, usable_w - 1.8*inch]\n",
    "    case_table = Table(case_table_data, colWidths=col_w)\n",
    "    case_table.setStyle(TableStyle([\n",
    "        ('VALIGN',        (0,0), (-1,-1), 'TOP'),\n",
    "        ('ROWBACKGROUNDS',(0,0), (-1,-1),\n",
    "         [colors.HexColor('#f5f7fa'), colors.white]),\n",
    "        ('TOPPADDING',    (0,0), (-1,-1), 8),\n",
    "        ('BOTTOMPADDING', (0,0), (-1,-1), 8),\n",
    "        ('LEFTPADDING',   (0,0), (-1,-1), 10),\n",
    "        ('RIGHTPADDING',  (0,0), (-1,-1), 10),\n",
    "        ('LINEBELOW',     (0,-1),(-1,-1), 0.5, colors.HexColor('#cccccc')),\n",
    "    ]))\n",
    "    story.append(case_table)\n",
    "    story.append(Spacer(1, 0.5*inch))\n",
    "    story.append(HRFlowable(width='100%', thickness=1,\n",
    "                            color=colors.HexColor('#cccccc')))\n",
    "    story.append(Spacer(1, 0.2*inch))\n",
    "\n",
    "    tab_summary_style = ParagraphStyle(\n",
    "        'TabSummary', parent=styles['Normal'],\n",
    "        fontName='Helvetica', fontSize=10,\n",
    "        textColor=colors.HexColor('#555555'), alignment=TA_CENTER)\n",
    "    plural = 's' if len(tabs_data) != 1 else ''\n",
    "    story.append(Paragraph(\n",
    "        'This brief contains <b>%d tab%s</b>.' % (len(tabs_data), plural),\n",
    "        tab_summary_style))\n",
    "    story.append(PageBreak())\n",
    "\n",
    "    # ── TABLE OF CONTENTS ────────────────────────────────────────────────\n",
    "    toc_title_style = ParagraphStyle(\n",
    "        'TOCTitle', parent=styles['Title'],\n",
    "        fontName='Helvetica-Bold', fontSize=18,\n",
    "        textColor=navy, spaceAfter=16, spaceBefore=0)\n",
    "    story.append(Paragraph('Table of Contents', toc_title_style))\n",
    "    story.append(HRFlowable(width='100%', thickness=2, color=gold))\n",
    "    story.append(Spacer(1, 0.25*inch))\n",
    "\n",
    "    toc_entry = ParagraphStyle(\n",
    "        'TOCEntry', parent=styles['Normal'],\n",
    "        fontName='Helvetica', fontSize=12, spaceAfter=6)\n",
    "    toc_header = ParagraphStyle(\n",
    "        'TOCHeader', parent=styles['Normal'],\n",
    "        fontName='Helvetica-Bold', fontSize=12,\n",
    "        spaceAfter=6, textColor=navy)\n",
    "    toc_page = ParagraphStyle(\n",
    "        'TOCPage', parent=styles['Normal'],\n",
    "        fontName='Helvetica', fontSize=12,\n",
    "        spaceAfter=6, alignment=TA_RIGHT)\n",
    "\n",
    "    toc_data = [[\n",
    "        Paragraph('<b>Tab</b>',         toc_header),\n",
    "        Paragraph('<b>Description</b>', toc_header),\n",
    "        Paragraph('<b>Page</b>',        toc_header),\n",
    "    ]]\n",
    "    for i, tab in enumerate(tabs_data, 1):\n",
    "        pg = str(tab_pages[i]) if (tab_pages and i in tab_pages) else '\\u2014'\n",
    "        toc_data.append([\n",
    "            Paragraph(str(i), toc_entry),\n",
    "            Paragraph(tab.get('title') or ('Tab %d' % i), toc_entry),\n",
    "            Paragraph(pg, toc_page),\n",
    "        ])\n",
    "    toc_table = Table(toc_data,\n",
    "                      colWidths=[0.6*inch, usable_w - 1.6*inch, 1*inch])\n",
    "    toc_table.setStyle(TableStyle([\n",
    "        ('ROWBACKGROUNDS', (0,1), (-1,-1),\n",
    "         [colors.HexColor('#f5f7fa'), colors.white]),\n",
    "        ('TOPPADDING',     (0,0), (-1,-1), 8),\n",
    "        ('BOTTOMPADDING',  (0,0), (-1,-1), 8),\n",
    "        ('LEFTPADDING',    (0,0), (-1,-1), 10),\n",
    "        ('LINEBELOW',      (0,0), (-1, 0), 1,   navy),\n",
    "        ('LINEBELOW',      (0,-1),(-1,-1), 0.5, colors.HexColor('#cccccc')),\n",
    "        ('VALIGN',         (0,0), (-1,-1), 'MIDDLE'),\n",
    "        ('ALIGN',          (2,0), (2, -1), 'RIGHT'),\n",
    "    ]))\n",
    "    story.append(toc_table)\n",
    "    story.append(PageBreak())\n",
    "\n",
    "    # ── TAB SECTIONS ─────────────────────────────────────────────────────\n",
    "    photo_caption = ParagraphStyle(\n",
    "        'PhotoCaption', parent=styles['Normal'],\n",
    "        fontName='Helvetica', fontSize=9,\n",
    "        textColor=colors.HexColor('#666666'),\n",
    "        alignment=TA_CENTER, spaceAfter=16)\n",
    "    no_file_style = ParagraphStyle(\n",
    "        'NoFile', parent=styles['Normal'],\n",
    "        fontName='Helvetica', fontSize=11,\n",
    "        textColor=colors.grey, alignment=TA_CENTER)\n",
    "    doc_caption = ParagraphStyle(\n",
    "        'DocCaption', parent=styles['Normal'],\n",
    "        fontName='Helvetica-Oblique', fontSize=8,\n",
    "        textColor=colors.HexColor('#888888'),\n",
    "        alignment=TA_CENTER, spaceAfter=4)\n",
    "\n",
    "    for tab_idx, tab in enumerate(tabs_data, 1):\n",
    "        # Tab divider page\n",
    "        story.append(TabDivider(\n",
    "            tab_number=tab_idx, tab_title=tab.get('title', ''),\n",
    "            width=usable_w, height=usable_h,\n",
    "            page_registry=page_registry, registry_key=tab_idx))\n",
    "        story.append(PageBreak())\n",
    "\n",
    "        files = tab.get('images', [])\n",
    "        if not files:\n",
    "            story.append(Spacer(1, 2*inch))\n",
    "            story.append(Paragraph('No files uploaded for this tab.', no_file_style))\n",
    "            story.append(PageBreak())\n",
    "            continue\n",
    "\n",
    "        # Separate images from documents\n",
    "        img_files = [(i, p) for i, p in enumerate(files) if is_image_file(p)]\n",
    "        doc_files = [(i, p) for i, p in enumerate(files) if not is_image_file(p)]\n",
    "\n",
    "        # ── Embed images (2 per page, scale UP small images) ──────────\n",
    "        img_counter = 0\n",
    "        for i in range(0, len(img_files), 2):\n",
    "            page_imgs = img_files[i:i+2]\n",
    "            for orig_idx, img_path in page_imgs:\n",
    "                img_counter += 1\n",
    "                try:\n",
    "                    with Image.open(img_path) as pil_img:\n",
    "                        orig_w, orig_h = pil_img.size\n",
    "                    max_w = usable_w\n",
    "                    max_h = (usable_h - 0.5*inch) / 2\n",
    "                    # FIX: Scale UP small images (remove the 1.0 cap)\n",
    "                    scale = min(max_w/orig_w, max_h/orig_h)\n",
    "                    # But cap at 4x to avoid extreme upscaling of tiny images\n",
    "                    scale = min(scale, 4.0)\n",
    "                    rl_img = RLImage(img_path,\n",
    "                                     width=orig_w*scale,\n",
    "                                     height=orig_h*scale)\n",
    "                    rl_img.hAlign = 'CENTER'\n",
    "                    story.append(rl_img)\n",
    "                    title_part = (' - ' + tab.get('title')) if tab.get('title') else ''\n",
    "                    caption_text = 'Tab %d%s | Photo %d — %s' % (\n",
    "                        tab_idx, title_part, img_counter,\n",
    "                        os.path.basename(img_path))\n",
    "                    story.append(Paragraph(caption_text, photo_caption))\n",
    "                    story.append(Spacer(1, 0.15*inch))\n",
    "                except Exception as e:\n",
    "                    story.append(Paragraph(\n",
    "                        '[Image could not be loaded: %s — %s]' % (\n",
    "                            os.path.basename(img_path), str(e)),\n",
    "                        photo_caption))\n",
    "            story.append(PageBreak())\n",
    "\n",
    "        # ── Non-image documents ──────────────────────────────────────\n",
    "        for orig_idx, doc_path in doc_files:\n",
    "            original_name = tab.get('original_names', {}).get(doc_path,\n",
    "                                                              os.path.basename(doc_path))\n",
    "            pdf_path = converted_pdfs.get(doc_path)\n",
    "\n",
    "            if pdf_path and HAS_PYMUPDF:\n",
    "                # We'll merge actual PDF pages directly\n",
    "                try:\n",
    "                    pdf_doc = pymupdf.open(pdf_path)\n",
    "                    num_pages = len(pdf_doc)\n",
    "                    pdf_doc.close()\n",
    "                except Exception:\n",
    "                    num_pages = 0\n",
    "\n",
    "                if num_pages > 0:\n",
    "                    # Add caption page\n",
    "                    story.append(Spacer(1, 0.3*inch))\n",
    "                    story.append(Paragraph(\n",
    "                        'Document: %s (%d page%s)' % (\n",
    "                            xml_escape(original_name),\n",
    "                            num_pages, 's' if num_pages != 1 else ''),\n",
    "                        doc_caption))\n",
    "                    story.append(HRFlowable(width='60%', thickness=0.5,\n",
    "                                            color=colors.HexColor('#dddddd')))\n",
    "                    story.append(Spacer(1, 0.1*inch))\n",
    "\n",
    "                    for pg_idx in range(num_pages):\n",
    "                        key = '%s_pg%d' % (doc_path, pg_idx)\n",
    "                        placeholder = PDFPagePlaceholder(\n",
    "                            usable_w, usable_h,\n",
    "                            label='%s — page %d/%d' % (\n",
    "                                original_name, pg_idx+1, num_pages),\n",
    "                            page_offset_registry=(\n",
    "                                {} if pdf_insert_plan is not None else None),\n",
    "                            registry_key=key,\n",
    "                        )\n",
    "                        story.append(placeholder)\n",
    "                        # Record for post-merge\n",
    "                        if pdf_insert_plan is not None:\n",
    "                            pdf_insert_plan.append({\n",
    "                                'placeholder_key': key,\n",
    "                                'pdf_path': pdf_path,\n",
    "                                'page_idx': pg_idx,\n",
    "                            })\n",
    "                        story.append(PageBreak())\n",
    "                    continue\n",
    "\n",
    "            # Fallback: couldn't convert to PDF\n",
    "            story.append(Spacer(1, 0.5*inch))\n",
    "            story.append(Paragraph(\n",
    "                'Document: %s' % xml_escape(original_name), doc_caption))\n",
    "            story.append(Paragraph(\n",
    "                '[This document could not be converted for embedding. '\n",
    "                'The original file should be provided separately.]',\n",
    "                ParagraphStyle('FallbackNote', parent=styles['Normal'],\n",
    "                               fontName='Helvetica-Oblique', fontSize=9,\n",
    "                               textColor=colors.grey, alignment=TA_CENTER)))\n",
    "            story.append(PageBreak())\n",
    "\n",
    "    return story\n",
    "\n",
    "\n",
    "# ─── PDF GENERATION (two-pass + direct PDF merge) ────────────────────────────\n",
    "\n",
    "def generate_evidence_brief(case_info, tabs_data, output_path):\n",
    "    \"\"\"Generate the final evidence brief PDF.\n",
    "\n",
    "    Strategy:\n",
    "    1. Convert all non-image docs to PDF (preserving layout)\n",
    "    2. Build ReportLab story with placeholders for PDF pages\n",
    "    3. Two-pass build for accurate TOC page numbers\n",
    "    4. Merge actual PDF pages over the placeholders using PyMuPDF\n",
    "    \"\"\"\n",
    "    page_w, page_h = letter\n",
    "    doc_kwargs = dict(\n",
    "        pagesize=letter,\n",
    "        leftMargin=0.75*inch, rightMargin=0.75*inch,\n",
    "        topMargin=0.75*inch, bottomMargin=0.75*inch)\n",
    "    usable_w = page_w - 1.5*inch\n",
    "    usable_h = page_h - 1.5*inch - 0.5*inch\n",
    "\n",
    "    # ── Step 1: Convert all non-image files to PDF ───────────────────\n",
    "    converted_pdfs = {}  # original_path → pdf_path\n",
    "    original_names = {}  # for all tabs\n",
    "\n",
    "    for tab in tabs_data:\n",
    "        tab_original_names = {}\n",
    "        for f in tab.get('images', []):\n",
    "            if not is_image_file(f) and f not in converted_pdfs:\n",
    "                print(f'Converting: {os.path.basename(f)}')\n",
    "                pdf_path = convert_document_to_pdf(f)\n",
    "                if pdf_path:\n",
    "                    converted_pdfs[f] = pdf_path\n",
    "                    print(f'  → OK: {os.path.basename(pdf_path)} '\n",
    "                          f'({get_pdf_page_count(pdf_path)} pages)')\n",
    "                else:\n",
    "                    print(f'  → Could not convert')\n",
    "        tab['original_names'] = tab_original_names\n",
    "\n",
    "    # ── Step 2: First pass — get page numbers ────────────────────────\n",
    "    page_registry = {}\n",
    "    pdf_insert_plan_1 = []\n",
    "    story1 = _build_story(\n",
    "        case_info, tabs_data, usable_w, usable_h,\n",
    "        page_registry=page_registry, tab_pages=None,\n",
    "        converted_pdfs=converted_pdfs,\n",
    "        pdf_insert_plan=pdf_insert_plan_1)\n",
    "\n",
    "    buf1 = io.BytesIO()\n",
    "    doc1 = SimpleDocTemplate(buf1, **doc_kwargs)\n",
    "    doc1.build(story1, canvasmaker=NumberedCanvas)\n",
    "\n",
    "    # ── Step 3: Second pass — with correct TOC page numbers ──────────\n",
    "    pdf_insert_plan = []\n",
    "    story2 = _build_story(\n",
    "        case_info, tabs_data, usable_w, usable_h,\n",
    "        page_registry=None, tab_pages=page_registry,\n",
    "        converted_pdfs=converted_pdfs,\n",
    "        pdf_insert_plan=pdf_insert_plan)\n",
    "\n",
    "    skeleton_path = output_path + '.skeleton.pdf'\n",
    "    doc2 = SimpleDocTemplate(skeleton_path, **doc_kwargs)\n",
    "    doc2.build(story2, canvasmaker=NumberedCanvas)\n",
    "\n",
    "    # ── Step 4: Merge PDF pages over placeholders ────────────────────\n",
    "    if pdf_insert_plan and HAS_PYMUPDF:\n",
    "        print(f'Merging {len(pdf_insert_plan)} document pages into final PDF...')\n",
    "        try:\n",
    "            _merge_pdf_pages(skeleton_path, output_path, pdf_insert_plan)\n",
    "        except Exception as e:\n",
    "            print(f'PDF merge failed: {e}\\n{traceback.format_exc()}')\n",
    "            # Fall back to skeleton\n",
    "            shutil.copy2(skeleton_path, output_path)\n",
    "    else:\n",
    "        shutil.copy2(skeleton_path, output_path)\n",
    "\n",
    "    # Cleanup skeleton\n",
    "    try:\n",
    "        os.unlink(skeleton_path)\n",
    "    except OSError:\n",
    "        pass\n",
    "\n",
    "    print(f'Final PDF: {output_path} ({get_pdf_page_count(output_path)} pages)')\n",
    "\n",
    "\n",
    "def _merge_pdf_pages(skeleton_path, output_path, insert_plan):\n",
    "    \"\"\"Replace placeholder pages in the skeleton with actual PDF pages.\n",
    "\n",
    "    Uses PyMuPDF to overlay the source PDF page onto each placeholder page,\n",
    "    preserving the footer from the skeleton while showing the real content.\n",
    "    \"\"\"\n",
    "    skeleton = pymupdf.open(skeleton_path)\n",
    "    output = pymupdf.open()  # new empty PDF\n",
    "\n",
    "    # Build a map of skeleton page number → source info\n",
    "    # We need to figure out which skeleton pages are placeholders.\n",
    "    # The placeholders were numbered by the NumberedCanvas.\n",
    "    # Since ReportLab builds sequentially, placeholder page N in the story\n",
    "    # corresponds to page N in the skeleton PDF.\n",
    "\n",
    "    # The insert_plan items have 'placeholder_key' but we need actual page numbers.\n",
    "    # We'll use a simpler approach: find placeholder pages by their text content,\n",
    "    # or just replace pages sequentially based on insert_plan order.\n",
    "\n",
    "    # Actually, since we build the story sequentially and each PDFPagePlaceholder\n",
    "    # takes exactly one page followed by a PageBreak, we can track which pages\n",
    "    # they land on by re-building with a counter.\n",
    "\n",
    "    # Simpler approach: scan skeleton for pages containing \"[Document page]\" or\n",
    "    # the specific labels. But even simpler — we know the order.\n",
    "\n",
    "    # Build skeleton page → source mapping using text search\n",
    "    replace_map = {}  # skeleton_page_idx → (pdf_path, page_idx)\n",
    "\n",
    "    for plan_item in insert_plan:\n",
    "        label = plan_item['placeholder_key']\n",
    "        pdf_path = plan_item['pdf_path']\n",
    "        pg_idx = plan_item['page_idx']\n",
    "\n",
    "        # Search skeleton for the placeholder text\n",
    "        for skel_page_idx in range(len(skeleton)):\n",
    "            if skel_page_idx in replace_map:\n",
    "                continue\n",
    "            page = skeleton[skel_page_idx]\n",
    "            text = page.get_text('text')\n",
    "            # Check if this page contains our placeholder label\n",
    "            # The label format is: \"filename — page X/Y\"\n",
    "            basename = os.path.basename(pdf_path).replace('.pdf', '')\n",
    "            search_str = 'page %d/' % (pg_idx + 1)\n",
    "            if search_str in text and ('[Document page]' in text\n",
    "                                       or basename[:15] in text\n",
    "                                       or 'page' in text.lower()):\n",
    "                replace_map[skel_page_idx] = (pdf_path, pg_idx)\n",
    "                break\n",
    "\n",
    "    # If text search didn't work well, try sequential approach\n",
    "    if len(replace_map) < len(insert_plan):\n",
    "        # Fallback: find pages with light gray background (our placeholder)\n",
    "        replace_map = {}\n",
    "        plan_idx = 0\n",
    "        for skel_page_idx in range(len(skeleton)):\n",
    "            if plan_idx >= len(insert_plan):\n",
    "                break\n",
    "            page = skeleton[skel_page_idx]\n",
    "            text = page.get_text('text').strip()\n",
    "            # Placeholder pages have very little text (just label + footer)\n",
    "            if '[Document page]' in text or '\\u2014 page' in text:\n",
    "                item = insert_plan[plan_idx]\n",
    "                replace_map[skel_page_idx] = (item['pdf_path'], item['page_idx'])\n",
    "                plan_idx += 1\n",
    "\n",
    "    # Build output: copy skeleton pages, replacing placeholder pages\n",
    "    # with overlaid source content\n",
    "    source_cache = {}  # pdf_path → pymupdf.Document\n",
    "\n",
    "    for skel_page_idx in range(len(skeleton)):\n",
    "        if skel_page_idx in replace_map:\n",
    "            pdf_path, pg_idx = replace_map[skel_page_idx]\n",
    "\n",
    "            # Open source PDF (cached)\n",
    "            if pdf_path not in source_cache:\n",
    "                source_cache[pdf_path] = pymupdf.open(pdf_path)\n",
    "            src_doc = source_cache[pdf_path]\n",
    "\n",
    "            if pg_idx < len(src_doc):\n",
    "                # Insert the source page\n",
    "                output.insert_pdf(src_doc, from_page=pg_idx, to_page=pg_idx)\n",
    "                out_page = output[-1]\n",
    "\n",
    "                # Scale source page to fit letter size with margins\n",
    "                src_rect = src_doc[pg_idx].rect\n",
    "                dst_w = page_w_pts = 612.0  # letter width in points\n",
    "                dst_h = page_h_pts = 792.0  # letter height in points\n",
    "\n",
    "                # Resize output page to letter\n",
    "                out_page.set_mediabox(pymupdf.Rect(0, 0, dst_w, dst_h))\n",
    "\n",
    "                # Copy footer from skeleton page\n",
    "                skel_page = skeleton[skel_page_idx]\n",
    "                # Draw footer line and text\n",
    "                footer_y = dst_h - 0.4*72  # 0.4 inch from bottom\n",
    "                tw = pymupdf.TextWriter(out_page.rect)\n",
    "                font = pymupdf.Font('helv')\n",
    "                # Page number\n",
    "                page_num_text = 'Page %d' % (skel_page_idx + 1)\n",
    "                tw.append((dst_w - 0.5*72 - font.text_length(page_num_text, fontsize=8),\n",
    "                           footer_y), page_num_text, font=font, fontsize=8)\n",
    "                # Brief label\n",
    "                tw.append((0.5*72, footer_y), 'Evidence Brief',\n",
    "                          font=font, fontsize=8)\n",
    "                tw.write_text(out_page, color=(0.4, 0.4, 0.4))\n",
    "\n",
    "                # Draw footer line\n",
    "                line_y = dst_h - 0.55*72\n",
    "                shape = out_page.new_shape()\n",
    "                shape.draw_line(\n",
    "                    pymupdf.Point(0.5*72, line_y),\n",
    "                    pymupdf.Point(dst_w - 0.5*72, line_y))\n",
    "                shape.finish(color=(0.8, 0.8, 0.8), width=0.5)\n",
    "                shape.commit()\n",
    "            else:\n",
    "                # Page index out of range; keep skeleton page\n",
    "                output.insert_pdf(skeleton, from_page=skel_page_idx,\n",
    "                                  to_page=skel_page_idx)\n",
    "        else:\n",
    "            # Keep skeleton page as-is\n",
    "            output.insert_pdf(skeleton, from_page=skel_page_idx,\n",
    "                              to_page=skel_page_idx)\n",
    "\n",
    "    output.save(output_path, garbage=3, deflate=True)\n",
    "    output.close()\n",
    "    skeleton.close()\n",
    "    for doc in source_cache.values():\n",
    "        doc.close()\n",
    "\n",
    "\n",
    "# ─── ROUTES ──────────────────────────────────────────────────────────────────\n",
    "\n",
    "@app.route('/')\n",
    "def index():\n",
    "    return render_template('index.html')\n",
    "\n",
    "\n",
    "@app.route('/upload', methods=['POST'])\n",
    "def upload_files():\n",
    "    if 'files' not in request.files:\n",
    "        return jsonify({'error': 'No files provided'}), 400\n",
    "    saved = []\n",
    "    for f in request.files.getlist('files'):\n",
    "        if not f or not f.filename:\n",
    "            continue\n",
    "        original_name = f.filename\n",
    "        ext = original_name.rsplit('.', 1)[-1].lower() if '.' in original_name else 'bin'\n",
    "        fname = '%s.%s' % (uuid.uuid4().hex, ext)\n",
    "        path = os.path.join(app.config['UPLOAD_FOLDER'], fname)\n",
    "        f.save(path)\n",
    "        thumb_name = None\n",
    "        is_image = False\n",
    "        try:\n",
    "            with Image.open(path) as img:\n",
    "                img.thumbnail((300, 300))\n",
    "                thumb_name = 'thumb_%s.png' % uuid.uuid4().hex\n",
    "                thumb_path = os.path.join(app.config['UPLOAD_FOLDER'], thumb_name)\n",
    "                img.save(thumb_path, 'PNG')\n",
    "                is_image = True\n",
    "        except Exception:\n",
    "            pass\n",
    "        saved.append({\n",
    "            'id': fname,\n",
    "            'thumb': thumb_name,\n",
    "            'original': fname,\n",
    "            'name': original_name,\n",
    "            'is_image': is_image,\n",
    "        })\n",
    "    return jsonify({'files': saved})\n",
    "\n",
    "\n",
    "@app.route('/thumbnail/<filename>')\n",
    "def get_thumbnail(filename):\n",
    "    path = os.path.join(app.config['UPLOAD_FOLDER'], filename)\n",
    "    if os.path.exists(path):\n",
    "        return send_file(path)\n",
    "    return '', 404\n",
    "\n",
    "\n",
    "@app.route('/generate', methods=['POST'])\n",
    "def generate():\n",
    "    data = request.get_json()\n",
    "    if not data:\n",
    "        return jsonify({'error': 'No data provided'}), 400\n",
    "\n",
    "    case_info = data.get('case_info', {})\n",
    "    tabs_data = data.get('tabs', [])\n",
    "\n",
    "    for tab in tabs_data:\n",
    "        resolved = []\n",
    "        for img_id in tab.get('images', []):\n",
